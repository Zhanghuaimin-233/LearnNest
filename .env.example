# Copy this file to .env only when you need an optional runtime integration.
# Never commit .env. Values are loaded only into the current process and are
# intentionally excluded from tasks, batches, reports, and SQLite projections.

# Optional: enables MiMo note, podcast, and TTS commands. Leave unset for the
# deterministic local video -> evidence -> note workflow.
# MIMO_API_KEY=

# Optional: use an OpenAI-compatible note provider instead of MIMO_API_KEY.
# These three values must be set together and must not be combined with MIMO_API_KEY.
# LEARNNEST_NOTE_API_KEY=
# LEARNNEST_NOTE_BASE_URL=https://example.invalid/v1
# LEARNNEST_NOTE_MODEL=
# LEARNNEST_NOTE_PROVIDER=openai-compatible
# LEARNNEST_NOTE_JSON_MODE=json_object
# LEARNNEST_NOTE_SAFE_INPUT_TOKENS=64000

# Optional: path to a local Hugging Face cache that already contains the ASR model.
# HUGGINGFACE_HUB_CACHE=D:\models

# Optional: runtime-only cookie for the explicit Douyin monitor adapter.
# DOUYIN_COOKIE=
